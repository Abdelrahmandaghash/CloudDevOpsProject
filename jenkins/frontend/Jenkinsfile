@Library('shared-lib') _

pipeline {
    agent any

    environment {
        REGION   = 'us-east-1'
        REGISTRY = '020139096861.dkr.ecr.us-east-1.amazonaws.com'      // change 020139096861
        IMAGE    = "${REGISTRY}/frontend:${BUILD_NUMBER}"
        REPO     = 'github.com/Abdelrahmandaghash/CloudDevOpsProject.git'  // change Abdelrahmandaghash
    }

    stages {
        stage('Build Image') {
            steps { buildImage(IMAGE, 'app/frontend') }
        }
        stage('Scan Image') {
            steps { scanImage(IMAGE) }
        }
        stage('Push Image') {
            steps { pushImage(IMAGE, REGISTRY, REGION) }
        }
        stage('Delete Image Locally') {
            steps { deleteImage(IMAGE) }
        }
        stage('Update Manifests') {
            steps { updateManifests('k8s/frontend-deployment.yaml', IMAGE) }
        }
        stage('Push Manifests') {
            steps { pushManifests(REPO) }
        }
    }
}
